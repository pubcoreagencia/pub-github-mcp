{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-github-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SERVICE_NAME": "pub-github-mcp",
    "ALLOWED_ORG": "pubcoreagencia",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
